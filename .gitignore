# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# pytest & coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables & secrets
.env
.env.local

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# Project Data (ignore large datasets, keep folder structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Saved Models (ignore large model binaries, keep deployment artifacts)
models/*
!models/.gitkeep
!models/best_model_pipeline.joblib
!models/logistic_regression_pipeline.joblib
!models/model_metadata.json

# Reports / figures generated during runs
reports/figures/*
!reports/figures/.gitkeep
